{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pdssp.github.io/stacplanet/v1.0.0/schema.json",
  "title": "PDSSP Planetary Data Schema for STACPlanet Items and Collections",
  "description": "Profile defining PDSSP-specific constraints for planetary data products. Applies to both STAC Items and Collections. Required extensions on an Item depend on whether the product is located: a null geometry relaxes the projection requirement.",
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "Feature"
          }
        }
      },
      "then": {
        "$ref": "#/definitions/item"
      }
    },
    {
      "if": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "Collection"
          }
        }
      },
      "then": {
        "$ref": "#/definitions/collection"
      }
    }
  ],
  "definitions": {
    "item": {
      "type": "object",
      "required": [
        "stac_extensions",
        "properties",
        "geometry"
      ],
      "properties": {
        "stac_extensions": {
          "type": "array",
          "allOf": [
            {
              "contains": {
                "type": "string",
                "pattern": "stac-extensions\\.github\\.io/ssys/"
              }
            },
            {
              "contains": {
                "type": "string",
                "pattern": "stac-extensions\\.github\\.io/product/"
              }
            },
            {
              "contains": {
                "type": "string",
                "pattern": "stac-extensions\\.github\\.io/processing/"
              }
            }
          ]
        },
        "properties": {
          "type": "object",
          "required": [
            "ssys:targets",
            "ssys:target_class",
            "version",
            "product:type",
            "processing:level"
          ],
          "properties": {
            "ssys:targets": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "List of solar system targets covered by the data (e.g. \"Mars\", \"Deimos\", \"Mgs\" for a spacecraft cross-calibration target). At least one target is required. Free text, matching the real ssys v1.1.1 extension's own (unconstrained) field -- not restricted to a short enum of common bodies."
            },
            "ssys:target_class": {
              "type": "string",
              "enum": [
                "asteroid",
                "dwarf_planet",
                "planet",
                "satellite",
                "comet",
                "exoplanet",
                "interplanetary_medium",
                "sample",
                "sky",
                "spacecraft",
                "spacejunk",
                "star",
                "calibration"
              ],
              "description": "Classification of the primary target -- the real ssys v1.1.1 extension's own enum (confirmed live against its schema.json), not just \"planet\"/\"satellite\": a calibration frame, a cross-calibration spacecraft target, or a starfield are all real, non-body targets a planetary archive actually has."
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "description": "Version identifier for the data product. Mandatory for items."
            },
            "product:type": {
              "type": "string",
              "enum": [
                "Image",
                "Image mosaic",
                "Orthoimage",
                "Anaglyph",
                "Digital elevation model",
                "Point cloud"
              ],
              "description": "Type of the data product, from the PDSSP Thesaurus's Product Type concept scheme (https://pdssp.github.io/pdssp-ontology/thesaurus/) -- deliberately NOT the EPN-TAP dataproduct_type long-name vocabulary (\"image\"/\"volume\"/...): that vocabulary is coarser than a planetary imaging archive needs (e.g. it has no term distinguishing an orthoimage or an anaglyph from a plain image), and mapping to/from EPN-TAP is left to whichever proxy needs it, not enforced here. This field is mandatory."
            },
            "processing:level": {
              "type": "string",
              "enum": [
                "Ancillary",
                "Raw",
                "Calibrated",
                "Derived"
              ],
              "description": "Processing level of the data product. This field is mandatory."
            },
            "pdssp:method": {
              "type": "string",
              "enum": [
                "Panchromatic imaging",
                "Multispectral imaging",
                "Hyperspectral imaging",
                "Visible light imaging",
                "Infrared imaging",
                "Thermal imaging",
                "Radar imaging",
                "Microwave imaging",
                "Lidar",
                "Aerial photography",
                "Photogrammetry",
                "Stereoscopic imaging",
                "Remote sensing"
              ],
              "description": "How the product was acquired or produced (the technique), e.g. panchromatic imaging, multispectral imaging, stereo photogrammetry. From the PDSSP Thesaurus's Method concept scheme (https://pdssp.github.io/pdssp-ontology/thesaurus/), which reuses the USGS Thesaurus's own \"methods\" facet where it fits and adds PDSSP-specific concepts (Photogrammetry, Stereoscopic imaging) where it doesn't."
            }
          }
        },
        "geometry": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "geometry"
            ],
            "properties": {
              "geometry": {
                "not": {
                  "type": "null"
                }
              }
            }
          },
          "then": {
            "properties": {
              "stac_extensions": {
                "allOf": [
                  {
                    "contains": {
                      "type": "string",
                      "pattern": "stac-extensions\\.github\\.io/projection/"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "stac_extensions"
            ],
            "properties": {
              "stac_extensions": {
                "contains": {
                  "type": "string",
                  "pattern": "stac-extensions\\.github\\.io/projection/"
                }
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "required": [
                  "proj:wkt2"
                ]
              }
            }
          }
        }
      ]
    },
    "collection": {
      "type": "object",
      "required": [
        "stac_extensions",
        "license",
        "ssys:targets",
        "ssys:target_class"
      ],
      "properties": {
        "stac_extensions": {
          "type": "array",
          "allOf": [
            {
              "contains": {
                "type": "string",
                "pattern": "stac-extensions\\.github\\.io/ssys/"
              }
            },
            {
              "contains": {
                "type": "string",
                "pattern": "stac-extensions\\.github\\.io/processing/"
              }
            },
            {
              "contains": {
                "type": "string",
                "pattern": "stac-extensions\\.github\\.io/product/"
              }
            }
          ]
        },
        "license": {
          "type": "string",
          "description": "License under which the data is provided."
        },
        "ssys:targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "List of solar system targets covered by this collection -- a direct top-level Collection field (not nested under \"properties\", which a STAC Collection does not have, nor under \"summaries\": a collection's own targets/target_class are a fact about the collection itself, same status as its license or providers, not a per-item value distribution). Free text, matching ssys v1.1.1's own unconstrained field."
        },
        "ssys:target_class": {
          "type": "string",
          "enum": [
            "asteroid",
            "dwarf_planet",
            "planet",
            "satellite",
            "comet",
            "exoplanet",
            "interplanetary_medium",
            "sample",
            "sky",
            "spacecraft",
            "spacejunk",
            "star",
            "calibration"
          ],
          "description": "Classification of this collection's primary target -- same top-level placement and enum as ssys:targets above."
        },
        "summaries": {
          "type": "object",
          "required": [
            "product:type",
            "processing:level"
          ],
          "properties": {
            "product:type": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Image",
                  "Image mosaic",
                  "Orthoimage",
                  "Anaglyph",
                  "Digital elevation model",
                  "Point cloud"
                ]
              },
              "minItems": 1,
              "description": "Every product:type value this collection's items actually use, from the PDSSP Thesaurus's Product Type concept scheme. This field is mandatory."
            },
            "processing:level": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Ancillary",
                  "Raw",
                  "Calibrated",
                  "Derived"
                ]
              },
              "minItems": 1,
              "description": "Every processing:level value this collection's items actually use. This field is mandatory."
            },
            "pdssp:method": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Panchromatic imaging",
                  "Multispectral imaging",
                  "Hyperspectral imaging",
                  "Visible light imaging",
                  "Infrared imaging",
                  "Thermal imaging",
                  "Radar imaging",
                  "Microwave imaging",
                  "Lidar",
                  "Aerial photography",
                  "Photogrammetry",
                  "Stereoscopic imaging",
                  "Remote sensing"
                ]
              },
              "minItems": 1,
              "description": "Every pdssp:method value this collection's items actually use, from the PDSSP Thesaurus's Method concept scheme."
            }
          }
        },
        "proj:wkt2": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "stac_extensions"
            ],
            "properties": {
              "stac_extensions": {
                "contains": {
                  "type": "string",
                  "pattern": "stac-extensions\\.github\\.io/projection/"
                }
              }
            }
          },
          "then": {
            "required": [
              "proj:wkt2"
            ]
          }
        }
      ]
    }
  }
}
